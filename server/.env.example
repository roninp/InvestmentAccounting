# ============================================================================
# Конфигурация backend-прокси T-Invest API (тариф «Про»)
# ----------------------------------------------------------------------------
# Для запуска прокси скопируйте этот файл в server/.env и заполните реальные
# значения. Файл server/.env добавлен в .gitignore — реальный токен НЕ должен
# попадать в систему контроля версий.
# ============================================================================

# Персональный токен T-Invest API. Получить можно в приложении Т-Инвестиций:
# https://developer.tbank.ru/invest/intro/intro -> «Токен»
TINVEST_TOKEN=

# Порт, на котором слушает прокси.
# Должен совпадать с константой TBANK_PROXY_URL в index.html.
PORT=8787

# Разрешить подключение к T-Invest API при корпоративном SSL-перехвате
# (самоподписанный сертификат в цепочке). Отключает проверку сертификата!
# Только для локальной разработки, значение "1" активирует обход.
# Если сеть обычная (без SSL-inspecting прокси) — оставьте пустым.
TINVEST_TLS_INSECURE=
