# ============================================================================
# Конфигурация backend-прокси Finam Trade API (тариф «Про»)
# ----------------------------------------------------------------------------
# Для запуска прокси скопируйте этот файл в server/.env и заполните реальные
# значения. Файл server/.env добавлен в .gitignore — реальный секрет НЕ должен
# попадать в систему контроля версий.
# ============================================================================

# Секретный токен Finam Trade API. Получить можно на портале Финама:
# https://api.finam.ru/tokens/  (раздел «Токены»)
FINAM_API_SECRET="tapi_sk_Xx_s9G6xSSKW9E4hrBK1uA"

# Порт, на котором слушает сервис (страница + API, единый origin).
# Приложение открывается по адресу http://localhost:<PORT>/
PORT=8787

# Разрешить подключение к Finam API при корпоративном SSL-перехвате
# (самоподписанный сертификат в цепочке). Отключает проверку сертификата!
# Только для локальной разработки, значение "1" активирует обход.
FINAM_TLS_INSECURE=1
